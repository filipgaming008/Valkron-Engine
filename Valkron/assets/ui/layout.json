{
  "schema": {
    "version": 1,
    "notes": [
      "All positions/sizes are in design-space units and are multiplied by runtime UI scale.",
      "Every element supports optional: id, layer.",
      "Panel supports optional children[] for hierarchy."
    ],
    "elementTypes": {
      "panel": {
        "required": ["type", "width", "height"],
        "optional": ["id", "layer", "x", "y", "title", "color", "padding", "spacing", "layout", "scrolling", "clipChildren", "scrollSpeed", "children"],
        "layoutValues": ["none", "vertical", "horizontal"]
      },
      "button": {
        "required": ["type", "width", "height"],
        "optional": ["id", "layer", "x", "y", "label", "color"]
      },
      "toggle": {
        "required": ["type", "width", "height"],
        "optional": ["id", "layer", "x", "y", "label", "offColor", "onColor", "value"]
      },
      "slider": {
        "required": ["type", "width", "height"],
        "optional": ["id", "layer", "x", "y", "label", "trackColor", "fillColor", "value"]
      },
      "dropdown": {
        "required": ["type", "width", "height"],
        "optional": ["id", "layer", "x", "y", "headerColor", "menuColor", "options", "selectedIndex"]
      },
      "textInput": {
        "required": ["type", "width", "height"],
        "optional": ["id", "layer", "x", "y", "color", "placeholder", "mode", "value"],
        "modeValues": ["any", "integer", "decimal"]
      }
    }
  },
  "requiredIds": [
    "playButton",
    "settingsButton",
    "quitButton",
    "bloomToggle",
    "exposureSlider",
    "qualityDropdown",
    "profileNameInput",
    "gammaInput"
  ],
